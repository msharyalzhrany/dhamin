# ============================================================
# إعدادات ضامن — انسخ هذا الملف باسم .env (أو شغّل: npm run setup)
# لا ترفع ملف .env على GitHub أبداً — فيه أسرار.
# ============================================================

# مفتاح سري لتشفير الجلسات. أمر setup يولّده لك تلقائياً.
# (يدوياً: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=change-me

# عنوان الموقع. محلياً الواجهة (Vite) على 5173 وهي تمرّر /api و /uploads للسيرفر على 3000، وعند النشر تغيّره لرابط موقعك (https://example.com)
BETTER_AUTH_URL=http://localhost:5173

# المنفذ (Railway يحدده بنفسه عند النشر)
PORT=3000

# مكان قاعدة البيانات (ملف SQLite).
# عند النشر على Railway مع Volume مركّب على /data:  file:/data/dhamin.db
DATABASE_URL=file:./data/dhamin.db

# مجلد الصور المرفوعة (على Railway ضعه داخل الـ Volume، مثلاً /data/uploads)
UPLOAD_DIR=./data/uploads

# عناوين إضافية مسموح لها بإرسال طلبات (مفصولة بفاصلة) — اختياري
# EXTRA_ORIGINS=https://example.com

# المساعد الذكي (اختياري): بدون مفتاح يعمل المساعد بإجابات جاهزة (FAQ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# إيميلات المشرفين لصفحة /app/admin (مفصولة بفاصلة)
ADMIN_EMAILS=
